{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PostgreSQL",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/start-postgres.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Build Workbook Snapshot",
      "type": "shell",
      "command": "npm run snapshot",
      "options": {
        "cwd": "${workspaceFolder}/db"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Re-migrate & Seed",
      "type": "shell",
      "command": "npm run migrate:seed",
      "dependsOn": ["Start PostgreSQL"],
      "options": {
        "cwd": "${workspaceFolder}/db"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Launch Backend API",
      "type": "npm",
      "script": "dev",
      "path": "server/",
      "isBackground": true,
      "dependsOn": ["Start PostgreSQL", "Build Workbook Snapshot"],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": {
        "owner": "stand-api",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "listening on"
        }
      }
    },
    {
      "label": "Launch Stand UI",
      "type": "npm",
      "script": "dev",
      "path": "stand/",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Ali: Run B1 Checks",
      "type": "shell",
      "command": "\"${env:LocalAppData}\\Programs\\Python\\Python312\\python.exe\" -m pytest ali/tests/test_checks.py -q",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Ali: Ask free question",
      "type": "shell",
      "command": "\"${env:LocalAppData}\\Programs\\Python\\Python312\\python.exe\" -m ali.agents.ask_agent \"What open cases need attention?\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Full Stack",
      "dependsOn": ["Start PostgreSQL", "Build Workbook Snapshot", "Launch Backend API", "Launch Stand UI"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
