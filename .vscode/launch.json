{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FTA: Backend API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/index.mjs",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "API_PORT": "8787",
        "TEMPORAL_ENABLED": "true"
      },
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "FTA: Frontend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/stand/node_modules/vite/bin/vite.js",
      "args": [
        "--host",
        "localhost",
        "--port",
        "5173",
        "--strictPort"
      ],
      "cwd": "${workspaceFolder}/stand",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "FTA: Full Stack",
      "configurations": [
        "FTA: Backend API",
        "FTA: Frontend"
      ],
      "preLaunchTask": "FTA: Prepare Full Stack",
      "stopAll": true
    }
  ]
}
