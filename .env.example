# Local Postgres only for now (Azure later). Copy to .env and set the password.
LOCAL_PGHOST=127.0.0.1
LOCAL_PGPORT=5432
LOCAL_PGDATABASE=gitex_stand
LOCAL_PGUSER=postgres
# Local stand password (SCRAM cannot use a blank password)
LOCAL_PGPASSWORD=gitex
LOCAL_PGSSLMODE=disable

API_PORT=8787

# One shared LLM for FTA agent + FTA Assistant (OpenAI-compatible; optional for tools-only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# auto: live when a key exists; offline otherwise. live requires a key.
LLM_MODE=auto
# openai (API-compatible endpoints) or cursor (local demo CLI adapter)
LLM_PROVIDER=openai
# CURSOR_API_KEY=
# CURSOR_MODEL=auto
# CURSOR_REQUEST_TIMEOUT=60
# CURSOR_CLI_DIR=C:\Users\YOUR_USER\AppData\Local\cursor-agent\fta-demo-2026.11.22-e9042b2\dist-package
# Requests with a configured provider report failures; no silent offline substitution.
LLM_REQUEST_TIMEOUT=15
LLM_MAX_OUTPUT_TOKENS=700
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0.2
# Local Temporal execution for agent requests; set to false to use the direct bridge.
TEMPORAL_ENABLED=false

