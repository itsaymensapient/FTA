    },
    {
      "type": "text",
      "id": "fta-connected-models-agents-text-56",
      "x": 64,
      "y": 1332,
      "width": 909.4399999999999,
      "height": 39.199999999999996,
      "text": "One interactive journey, rather than independent answers",
      "size": 28,
      "color": "#182C3A",
      "weight": 600,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "fta-connected-models-agents-text-57",
      "x": 64,
      "y": 1386,
      "width": 1075.32,
      "height": 25.2,
      "text": "Start → investigate → ask/review evidence → explain → preview → approve → execute → verify → follow up.",
      "size": 18,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "fta-connected-models-agents-text-58",
      "x": 64,
      "y": 1420,
      "width": 1252.8,
      "height": 25.2,
      "text": "A reply can return the case to investigation. A changed preview needs fresh approval. A pending operation stays pending.",
      "size": 18,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "fta-connected-models-agents-text-59",
      "x": 64,
      "y": 1454,
      "width": 1221.48,
      "height": 25.2,
      "text": "Every handoff carries: case + trusted scope + task + instruction versions + evidence references + expected next step.",
      "size": 18,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "rectangle",
      "id": "scope-note",
      "x": 64,
      "y": 1536,
      "width": 1472,
      "height": 80,
      "fill": "#EEF7F4",
      "stroke": "#D8E0E5",
      "dash": false
    },
    {
      "type": "text",
      "id": "fta-connected-models-agents-text-60",
      "x": 88,
      "y": 1548,
      "width": 1287.6,
      "height": 28,
      "text": "Scenario 2: reconciliation   ·   Scenario 3: refund evidence   ·   Scenario 4: disclosure and period allocation",
      "size": 20,
      "color": "#182C3A",
      "weight": 600,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "fta-connected-models-agents-text-61",
      "x": 88,
      "y": 1579,
      "width": 1242.36,
      "height": 23.799999999999997,
      "text": "Same workflow engine, different approved instructions and tools. Scenario 5 remains optional until its interaction is defined.",
      "size": 17,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "fta-connected-models-agents-text-62",
      "x": 64,
      "y": 1652,
      "width": 925.68,
      "height": 19.599999999999998,
      "text": "Proposed wiring, not a live deployment. Shared components do not imply shared taxpayer data or automatic approval.",
      "size": 14,
      "color": "#536674",
      "weight": 400,
      "anchor": "start"
    }
