      "id": "learn-04-actions-text-58",
      "x": 1032,
      "y": 1667,
      "width": 443.7,
      "height": 23.799999999999997,
      "text": "An approval record tied to preview v1. Cancel",
      "size": 17,
      "color": "#536674",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "learn-04-actions-text-59",
      "x": 1032,
      "y": 1692,
      "width": 226.77999999999997,
      "height": 23.799999999999997,
      "text": "produces no submission.",
      "size": 17,
      "color": "#536674",
      "weight": 400,
      "anchor": "start"
    },
