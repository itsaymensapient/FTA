      "weight": 600,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "learn-04-actions-text-55",
      "x": 136,
      "y": 1668,
      "width": 104.39999999999999,
      "height": 25.2,
      "text": "Human user",
      "size": 18,
      "color": "#182C3A",
      "weight": 600,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "learn-04-actions-text-56",
      "x": 360,
      "y": 1667,
      "width": 631.04,
      "height": 23.799999999999997,
      "text": "Reviews the exact preview and selects Approve. If the user edits",
      "size": 17,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "learn-04-actions-text-57",
