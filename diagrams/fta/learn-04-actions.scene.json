      "size": 17,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "learn-04-actions-text-83",
      "x": 1032,
      "y": 2147,
      "width": 443.7,
      "height": 23.799999999999997,
      "text": "Both roles agree on the case status. “Closed”",
