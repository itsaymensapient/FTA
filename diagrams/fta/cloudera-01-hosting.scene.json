      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "cloudera-01-hosting-text-48",
      "x": 64,
      "y": 1357,
      "width": 1271.9399999999998,
      "height": 23.799999999999997,
      "text": "Approved instruction files ship with the workflow release or load from controlled storage. RAG is added only for document lookup.",
      "size": 17,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "cloudera-01-hosting-text-49",
      "x": 64,
      "y": 1391,
      "width": 1271.9399999999998,
      "height": 23.799999999999997,
      "text": "Business effects go through a backend API. Gold remains an analytical source; case state is stored durably outside worker memory.",
      "size": 17,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
    {
      "type": "text",
      "id": "cloudera-01-hosting-text-50",
      "x": 64,
      "y": 1425,
      "width": 1340.9599999999998,
      "height": 23.799999999999997,
      "text": "A shared service account does not automatically become the visitor’s identity: enforce company scope in trusted tools and data policies.",
      "size": 17,
      "color": "#182C3A",
      "weight": 400,
      "anchor": "start"
    },
