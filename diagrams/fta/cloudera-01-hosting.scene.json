    {
      "type": "text",
      "id": "cloudera-01-hosting-text-47",
      "x": 64,
      "y": 1323,
      "width": 1212.78,
      "height": 23.799999999999997,
      "text": "Workbench runs our application and workflow code. AI Inference supplies language generation. Gold supplies factual records.",
